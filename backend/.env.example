# Copy to .env and fill in what you need — every value here has a working
# default in app/config.py, so an empty/missing .env is fine for local dev.
# pydantic-settings loads this file automatically (see Settings.model_config).

# --- Database -----------------------------------------------------------
# Default: local SQLite file, zero setup. docker-compose overrides this with
# a Postgres DSN — see docker-compose.yml.
APP_DATABASE_URL=sqlite:///./attendance.db

# --- CORS -----------------------------------------------------------------
# JSON array of allowed frontend origins.
APP_CORS_ORIGINS=["http://localhost:3000"]

# --- Skill scoring (business-requirements.md #10-11) -----------------------
# APP_SKILL_SCORE_GIOI=3.0
# APP_SKILL_SCORE_TRUNG_BINH=2.0
# APP_SKILL_SCORE_YEU=1.0
# APP_SKILL_SCORE_UNKNOWN=2.0

# --- Team configuration suggestion rules (business-requirements.md #21) ----
# APP_PREFERRED_TEAM_SIZE=7
# APP_MIN_TEAM_SIZE=6
# APP_MAX_TEAM_SIZE=8
# APP_PREFERRED_TEAM_COUNTS=[2,3]

# --- Balancing engine (business-requirements.md #28) ------------------------
# APP_BALANCING_ITERATIONS=500
# APP_BALANCING_TIE_TOLERANCE=0.01

# APP_DEFAULT_TEAM_COLORS=["WHITE","RED","BLUE","YELLOW","BLACK","GREEN"]

# --- Real Zalo integration (optional — Phase 2) -----------------------------
# Deliberately WITHOUT the APP_ prefix: these are third-party credentials, not
# app tuning knobs, and this naming lets them be set once in the environment's
# secret store independent of everything above. Leave both unset and the app
# stays on NullMessagePublisher / manual attendance sync — nothing breaks.
# Get a bot token at https://bot.zaloplatforms.com, invite it to your group,
# then find the group's chat_id (e.g. from an incoming update).
ZALO_BOT_TOKEN=
ZALO_GROUP_CHAT_ID=
# ZALO_BOT_API_BASE_URL=https://bot-api.zapps.me
# ZALO_CHECKIN_KEYWORD=tham gia
